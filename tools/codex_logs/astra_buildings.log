renderer/rendering_method=\"gl_compatibility\"
'@ | Set-Content -Encoding ascii (Join-Path "'$qa '"'project.godot')
@'
extends SceneTree

var failures: int = 0

func _initialize() -> void:
    call_deferred(\"check_assets\")

func expect(ok: bool, desc: String) -> void:
    if not ok:
        failures += 1
        push_error(desc)

func cast(node: Node3D, a: Vector3, b: Vector3) -> Dictionary:
    return node.get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(a,b))

func check_assets() -> void:
    for key: String in [\"greenhouse\",\"house\"]:
        var asset: PackedScene = load(\"res://%s.glb\" % key)
        var obj: Node3D = asset.instantiate() as Node3D
        root.add_child(obj)
        await physics_frame
        await physics_frame
        var shapes: Array[Node] = obj.find_children(\"*\",\"CollisionShape3D\",true,false)
        expect(shapes.size()==9,key+\" collision count\")
        print(key,\" shapes \",shapes.size())
        var edge: float = .91 if key==\"greenhouse\" else .86
        for x: float in [-edge,0.0,edge]:
            for h: float in [.2,1.0,2.10]:
                expect(cast(obj,Vector3(x,h,4),Vector3(x,h,2.55)).is_empty(),key+\" entry\")
        expect(not cast(obj,Vector3(2,1.3,4),Vector3(2,1.3,2.4)).is_empty(),key+\" front wall\")
        if key==\"greenhouse\":
            for z: float in [.78,-1.77]:
                for x: float in [-4,-2.4,-.8,.8,2.4,4]:
                    var hit: Dictionary = cast(obj,Vector3(x,1.5,z),Vector3(x,.3,z))
                    expect(not hit.is_empty() and is_equal_approx(hit.position.y,.8),\"bench seat\")
        obj.free()
    print(\"failures \",failures)
    quit(failures)
