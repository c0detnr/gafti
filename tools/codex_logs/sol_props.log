import json
import struct
from pathlib import Path

from PIL import Image


root = Path.cwd()
props = root / \"assets/models/props\"
previews = root / \"tools/previews\"
names = \"\"\"pot grow_lamp shelf_shop counter cash_register drying_rack jar rolling_table generator
water_tank watering_can fence spruce_tree tea_bush rock_01 rock_02 bench lamp_post sofa mirror
bed crate tavla_table\"\"\".split()
collision_names = {
    \"shelf_shop\": \"Shelf\", \"counter\": \"Counter\", \"drying_rack\": \"DryingRack\",
    \"generator\": \"Generator\", \"water_tank\": \"Tank\", \"fence\": \"Fence\",
    \"spruce_tree\": \"Trunk\", \"rock_01\": \"Rock\", \"rock_02\": \"Rock\",
    \"sofa\": \"Sofa\", \"bed\": \"Bed\",
}


def read_gltf(path):
    with path.open(\"rb\") as file:
        magic, version, file_size = struct.unpack(\"<4sII\", file.read(12))
        assert (magic, version, file_size) == (b\"glTF\", 2, path.stat().st_size)
        length, kind = struct.unpack(\"<I4s\", file.read(8))
        assert kind == b\"JSON\"
        return json.loads(file.read(length))


assert set(names) == {path.stem for path in props.glob(\"*.glb\")}
result = []
bounds = {}
for name in names:
    glb = read_gltf(props / f\"{name}.glb\")
    scene_root, = glb[\"scenes\"][glb[\"scene\"]][\"nodes\"]
    assert glb[\"nodes\"][scene_root] == {\"name\": name, \"children\": glb[\"nodes\"][scene_root][\"children\"]}
    nodes = dict((node[\"name\"], node) for node in glb[\"nodes\"] if \"mesh\" in node)
    material_by_node = {}
    triangles = 0
    visual_bounds = []
    collider = collision_names.get(name)
    assert [node for node in nodes if node.endswith(\"-col\")] == ([collider + \"-col\"] if collider else [])
    for node_name, node in nodes.items():
        assert not {\"scale\", \"rotation\", \"matrix\"}.intersection(node), node
        translation = node.get(\"translation\", [0, 0, 0])
        primitives = glb[\"meshes\"][node[\"mesh\"]][\"primitives\"]
        materials = []
        for primitive in primitives:
            assert primitive.get(\"mode\", 4) == 4
            number_of_indices = glb[\"accessors\"][primitive[\"indices\"]][\"count\"]
            assert number_of_indices % 3 == 0
            triangles += number_of_indices // 3
            mat = glb[\"materials\"][primitive[\"material\"]]
            assert \"pbrMetallicRoughness\" in mat
            materials.append(mat)
            accessor = glb[\"accessors\"][primitive[\"attributes\"][\"POSITION\"]]
            if node_name.endswith(\"-col\"):
                assert mat[\"alphaMode\"] == \"BLEND\"
                assert mat[\"pbrMetallicRoughness\"][\"baseColorFactor\"][3] == 0
            else:
                visual_bounds.append([(accessor[\"min\"][i] + translation[i],
                                       accessor[\"max\"][i] + translation[i])
                                      for i in range(3)])
        material_by_node[node_name] = materials
    assert 0 < triangles <= 2000, (name, triangles)
    lower = [min(b[i][0] for b in visual_bounds) for i in range(3)]
    upper = [max(b[i][1] for b in visual_bounds) for i in range(3)]
    assert abs(lower[1]) < 1e-5, (name, lower[1])
    bounds[name] = tuple(upper[i] - lower[i] for i in range(3))
    if name == \"jar\":
        assert \"Lid\" in nodes and material_by_node[\"Glass\"][0][\"alphaMode\"] == \"BLEND\"
    if name == \"grow_lamp\":
        glow = material_by_node[\"Bulb\"][0]
        r, g, b = glow[\"emissiveFactor\"]
        assert r > g > b > 0 and glow[\"extensions\"][\"KHR_materials_emissive_strength\"][\"emissiveStrength\"] > 1
    with Image.open(previews / f\"{name}.png\") as img:
        assert img.size == (512, 512), (name, img.size)
        img.verify()
    result.append((name, triangles, \", \".join(f\""'`{node}`" for node in sorted(nodes))))

assert abs(bounds["pot"][0] - .3) < .002
assert abs(bounds["shelf_shop"][1] - 1.8) < .02
assert abs(bounds["counter"][1] - .9) < .002
with Image.open(previews / "props_sheet.png") as sheet:
    assert sheet.size == (2632, 2812)
    sheet.verify()

