@'
extends SceneTree

func _initialize() -> void:
    var required: Dictionary = {
        \"shelf_shop\": \"Shelf\", \"counter\": \"Counter\", \"drying_rack\": \"DryingRack\",
        \"generator\": \"Generator\", \"water_tank\": \"Tank\", \"fence\": \"Fence\",
        \"spruce_tree\": \"Trunk\", \"rock_01\": \"Rock\", \"rock_02\": \"Rock\",
        \"sofa\": \"Sofa\", \"bed\": \"Bed\"
    }
    var count: int = 0
    for entry: String in DirAccess.get_files_at(\"res://props\"):
        if not entry.ends_with(\".glb\"):
            continue
        var model: PackedScene = load(\"res://props/\" + entry) as PackedScene
        if model == null:
            printerr(\"Missing model: \" + entry)
            quit(1)
            return
        var instance: Node = model.instantiate()
        var key: String = entry.get_basename()
        if required.has(key):
            var visual: Node = instance.find_child(required[key], true, false)
            if not visual is MeshInstance3D or visual.find_children(\"*\", \"CollisionShape3D\", true, false).is_empty():
                printerr(\"Missing imported collision: \" + entry)
                instance.free()
                quit(1)
                return
        if key == \"jar\":
            var glass: MeshInstance3D = instance.find_child(\"Glass\", true, false) as MeshInstance3D
            var glass_mat: StandardMaterial3D = glass.mesh.surface_get_material(0) as StandardMaterial3D
            if glass_mat.transparency "'!= BaseMaterial3D.TRANSPARENCY_ALPHA or instance.find_child("Lid", true, false) == null:
                printerr("Jar is missing alpha blending or the Lid node")
                instance.free()
                quit(1)
                return
        if key == "grow_lamp":
            var bulb: MeshInstance3D = instance.find_child("Bulb", true, false) as MeshInstance3D
            var bulb_mat: StandardMaterial3D = bulb.mesh.surface_get_material(0) as StandardMaterial3D
            if not bulb_mat.emission_enabled:
                printerr("Grow lamp emission missing")
                instance.free()
                quit(1)
                return
        count += 1
        instance.free()
    print("GAFTI: ", count, " GLBs loaded. ", required.size(), " collisions checked.")
    quit(0 if count == 23 else 1)
