@tool
extends EditorScenePostImport

# The importer simplifies each surface independently. Reserve a portion of the
# whole-plant LOD1 budget for each of the three parts.
const TRIANGLES: Dictionary[StringName, int] = {&\"Leaves\": 480, &\"Stem\": 200, &\"Buds\": 320}


func _post_import(scene: Node) -> Object:
	for child: Node in scene.find_children(\"*\", \"MeshInstance3D\", true, false):
		var instance: MeshInstance3D = child as MeshInstance3D
		var source: ArrayMesh = instance.mesh as ArrayMesh
		var lods: Dictionary = source._surface_get_lods(0)
		var retained: Dictionary = {}
		for distance: float in lods:
			var indices: PackedInt32Array = lods[distance]
			if indices.size() <= 3 * TRIANGLES[instance.name]:
				retained[distance] = indices
		if retained.size() == lods.size():
			continue
		var mesh: ArrayMesh = ArrayMesh.new()
		mesh.resource_name = source.resource_name
		mesh.add_surface_from_arrays(source.surface_get_primitive_type(0),
				source.surface_get_arrays(0), [], retained,
				source.surface_get_format(0) & Mesh.ARRAY_FLAG_COMPRESS_ATTRIBUTES)
		mesh.surface_set_material(0, source.surface_get_material(0))
		mesh.surface_set_name(0, source.surface_get_name(0))
		instance.mesh = mesh
	return scene
