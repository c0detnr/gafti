 b=(base/'assets/models/hero'/(stem+'.glb')).read_bytes()
 ln=struct.unpack_from('<I',b,12)[0]; d=json.loads(b[20:20+ln]); buf=b[28+ln:]; access=d['accessors']
 def vals(idx):
  a=access[idx];v=d['bufferViews'][a['bufferView']]; fmt={5126:'f',5123:'H',5121:'B'}[a['componentType']]*{'VEC2':2,'VEC3':3,'VEC4':4}[a['type']]
  return [struct.unpack_from('<'+fmt,buf,v.get('byteOffset',0)+a.get('byteOffset',0)+i*v.get('byteStride',struct.calcsize(fmt))) for i in range(a['count'])]
 assert {n['name'] for n in d['nodes']}==({'Stem','Leaves'} if name in ('germ','seedling') else {'Stem','Leaves','Buds'})
 low=1; high=0; tris=0
 for m in d['meshes']:
  p=m['primitives'][0]; a=p['attributes']; positions=access[a['POSITION']]; low=min(low,positions['min'][1]);high=max(high,positions['max'][1]);tris+=access[p['indices']]['count']//3
  colors=vals(a['COLOR_0']);uv=vals(a['TEXCOORD_0'])
  if m['name']=='Stem': assert all(c[0]==0 for c in colors)
