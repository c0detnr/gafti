            if style==5:
                for s in (-1,1): h.oval((s*.179,.016,1.45),(.05,.14,.127),hair,\"head\",12,5,s*.18)
        elif style==2:
            for i in range(12):
                a=2*pi*i/12
                h.oval((.166*cos(a),.149*sin(a),1.616+.034*(-sin(a))),(.067,.067,.066),hair,\"head\",8,4)
