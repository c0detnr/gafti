# Sculpted hairlines wrap high across the forehead and low over the nape.
def scalp(part,style):
    rings=[]
    for j in range(6):
        ring=[]
        for i in range(20):
            a=2*pi*i/20; front=max(0,-sin(a))
            edge=-.52+1.05*front+.06*cos(3*a+style)
            v=edge+(1.54-edge)*j/5
            ring.append((.211*cos(v)*cos(a),.005+.196*cos(v)*sin(a),1.494+.247*sin(v)))
        rings.append(ring)
    part.surface(rings,hair,[\"head\"]*6)

