def bridge_height(y):
    return 1 + .58 * (1 - (y / 5) ** 2) ** 1.5


def arch_block(group, x, thickness, start, end, inside, outside, color, soft=.014):
    points = [(start, inside), (end, inside), (end, outside), (start, outside)]
    vertices = [(xx, 3.25 * radius * cos(angle), -.24 + 1.37 * radius * sin(angle))
                for xx in (x - thickness / 2, x + thickness / 2) for angle, radius in points]
    obj = mesh(group, vertices, [(0, 1, 2, 3), (7, 6, 5, 4), (4, 5, 1, 0),
                                 (5, 6, 2, 1), (6, 7, 3, 2), (7, 4, 0, 3)], swatch(color))
    if soft:
        bevel(obj, soft)
    add_part(obj, group)


def bridge():
    # The placed GLB origin sits at creek-bed height. Both ramp ends are 1 m higher.
    angles = [i * pi / 16 for i in range(17)]
    profile = sorted({-5, 5, -4.25, 4.25, *[3.25 * cos(a) for a in angles]})
    sections = []
    for y in profile:
        under = -.24 + 1.37 * sqrt(max(0, 1 - (y / 3.25) ** 2))
        sections.append([(-1.38, y, under), (-1.38, y, bridge_height(y)),
                         (1.38, y, bridge_height(y)), (1.38, y, under)])
    skin_between("Arch", sections, ["Stone"])
    for i in range(16):
        a0, a1 = angles[i], angles[i + 1]
        for side in (-1, 1):
            arch_block("Voussoirs", side * 1.37, .21, a0 + .009, a1 - .009, .995, 1.22, "Cobbles")
    for side in (-1, 1):
        for row in range(3):
            for i in range(16):
                y = (i - 7.5) * .61 + (.09 if row % 2 else 0)
                top = bridge_height(y)
                bottom = top - .24 - row * .21
                inner_edge = max(0, abs(y) - .31)
                if inner_edge < 3.95:
                    arch_top = -.24 + 1.67 * sqrt(max(0, 1 - (inner_edge / 3.95) ** 2))
                    if bottom < arch_top:
                        continue
                box("Spandrel", (side * 1.39, y, bottom + .085), (.16, .567, .18),
                    "Stone", .031)
        for i in range(16):
            a = -5 + i * .625
            b = a + .625
            mid = (a + b) / 2
            za, zb = bridge_height(a), bridge_height(b)
            angle = atan2(za - zb, b - a)
            # Box pitch is around X because the bridge crosses along Blender Y.
            parapet = box("Parapets", (side * 1.25, mid, (za + zb) / 2 + .292),
                          (.35, .616, .56), "Stone", .037)
            parapet.rotation_euler.x = -angle
            cap = box("Parapets", (side * 1.25, mid, (za + zb) / 2 + .602),
                      (.43, .617, .13), "Cobbles", .035)
            cap.rotation_euler.x = -angle
            rail = box("Parapets-col", (side * 1.25, mid, (za + zb) / 2 + .32),
                       (.38, .64, .66))
            rail.rotation_euler.x = -angle
            if i in (1, 4, 10, 14):
                box("Lichen", (side * 1.477, mid, (za + zb) / 2 + .14), (.016, .20, .085),
                    "Lichen", .007)
        for y in (-4.81, 4.81):
            box("End piers", (side * 1.25, y, 1.09), (.60, .43, 1.43), "Stone", .061)
            box("End piers", (side * 1.25, y, 1.84), (.66, .48, .14), "Cobbles", .041)
            box("Parapets-col", (side * 1.25, y, 1.09), (.57, .41, 1.60))
    for i in range(23):
        a, b = -5 + i * 10 / 23, -5 + (i + 1) * 10 / 23
        y = (a + b) / 2
        pitch = atan2(bridge_height(b) - bridge_height(a), b - a)
        for j in range(5):
            x = (j - 2) * .406 + (.041 if i % 2 else -.041)
            obj = box("Cobbled deck", (x, y, bridge_height(y) + .026),
                      (.385, b - a - .021, .055), "Cobbles", .015)
            obj.rotation_euler.x = pitch
    coords = [(x, y, bridge_height(y) + .048) for y in profile for x in (-1.14, 1.14)]
    deck_faces = [(i, i + 1, i + 3, i + 2) for i in range(0, len(coords) - 2, 2)]
    add_part(mesh("Deck-col", coords, deck_faces), "Deck-col")


def main():
    for name in (*BUILDINGS, "bus_stop", "minibus", "bridge"):
        reset_scene()
        if name in BUILDINGS:
            building(name)
        else:
            globals()[name]()
        objects = combine()
        export(name, objects, 8000)
        if name == "bridge":
            studio(name, 12.0, (1.05, -.72, .53), (0, 0, .34))
        elif name == "minibus":
            studio(name, 6.55, (.86, -1, .49), (0, 0, 1.18))
        elif name == "bus_stop":
            studio(name, 6.37, (.54, -1, .61), (0, 0, 1.40))
        else:
            w, d, eave, rise, *_ = BUILDINGS[name]
