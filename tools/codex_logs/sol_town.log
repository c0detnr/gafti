@'
from pathlib import Path
import json
import struct

from PIL import Image

ROOT = Path.cwd()
MODELS = ROOT / \"assets/models/town\"
NAMES = (\"shop_building\", \"kahvehane\", \"muhtarlik\", \"hardware_store\", \"inspection_office\",
         \"bus_stop\", \"minibus\", \"drying_barn\", \"bridge\", \"terrain\")


def verify(name):
    data = (MODELS / f\"{name}.glb\").read_bytes()
    magic, version, size, json_size = struct.unpack_from(\"<4sIII\", data)
    assert (magic, version, size) == (b\"glTF\", 2, len(data))
    gltf = json.loads(data[20:20+json_size])
    bin_offset = 28+json_size
    nodes, primitives = {}, {}
    for node in gltf[\"nodes\"]:
        assert \"rotation\" not in node and \"scale\" not in node and \"translation\" not in node
        prim = gltf[\"meshes\"][node[\"mesh\"]][\"primitives\"]
        nodes[node[\"name\"]] = sum(gltf[\"accessors\"][p[\"indices\"]][\"count\"]//3 for p in prim)
        primitives[node[\"name\"]] = prim
    total = sum(nodes.values())
    assert total <= (60000 if name==\"terrain\" else 8000), (name, total)
    assert any(node.endswith(\"-col\") for node in nodes)

    def elements(index):
        accessor = gltf[\"accessors\"][index]
        view = gltf[\"bufferViews\"][accessor[\"bufferView\"]]
        kind = {5123:\"H\",5125:\"I\",5126:\"f\"}[accessor[\"componentType\"]]
        count = {\"SCALAR\":1,\"VEC3\":3}[accessor[\"type\"]]
        parser = struct.Struct(\"<\"+kind*count)
        start = bin_offset + view.get(\"byteOffset\",0) + accessor.get(\"byteOffset\",0)
        stride = view.get(\"byteStride\",parser.size)
        return [parser.unpack_from(data,start+i*stride) for i in range(accessor[\"count\"])]

    def surface_at(node, x, z):
        prim = primitives[node][0]
        verts = elements(prim[\"attributes\"][\"POSITION\"])
        indices = elements(prim[\"indices\"])
        for i in range(0,len(indices),3):
            a,b,c = [verts[indices[j][0]] for j in range(i,i+3)]
            bx,bz,cx,cz = b[0]-a[0],b[2]-a[2],c[0]-a[0],c[2]-a[2]
            dx,dz = x-a[0],z-a[2]
            det = bx*cz-bz*cx
            if abs(det)<1e-8:
                continue
            wb, wc = (dx*cz-dz*cx)/det, (bx*dz-bz*dx)/det
            if wb>=-.0001 and wc>=-.0001 and wb+wc<=1.0001:
                return a[1]+wb*(b[1]-a[1])+wc*(c[1]-a[1])
        return None

    if name==\"terrain\":
        assert set(nodes)=={\"Ground\",\"Road\",\"Creek\",\"Water\",\"Ground-col\"}
        for node in (\"Ground\",\"Road\",\"Creek\",\"Water\"):
            assert \"COLOR_0\" in primitives[node][0][\"attributes\"]
        ground = elements(primitives[\"Ground\"][0][\"attributes\"][\"POSITION\"])
        assert [(min(p[k] for p in ground),max(p[k] for p in ground)) for k in (0,2)]==[(-130,130)]*2
        water = elements(primitives[\"Water\"][0][\"attributes\"][\"POSITION\"])
        heights = {round(p[1],5) for p in water}
        coords = {(round(p[0],5), round(p[2],5)) for p in water}
        assert heights == {-.69}
        assert {(-130,-60),(130,-35),(5,-45)} <= coords
        assert abs(surface_at(\"Creek\",5,-45)+1)<.001
        for x,z in [(-50,25),(0,10),(40,0),(60,0),(72,48),(5,-40),(5,-50),(0,-110)]:
            assert surface_at(\"Road\",x,z) is not None, (x,z)
    else:
        if name "'!= "bridge":
            geometry = [p for key, value in primitives.items() if not key.endswith("-col") for p in value]
            y_min = min(gltf["accessors"][p["attributes"]["POSITION"]]["min"][1] for p in geometry)
            assert abs(y_min) < .001, (name,y_min)
    assert Image.open(ROOT/"tools/previews"/f"{name}.png").size == (512,512)
    return total, nodes


if __name__ == "__main__":
    assert Image.open(ROOT/"tools/previews/terrain_top.png").size == (512,512)
    print(json.dumps({n: verify(n) for n in NAMES}, ensure_ascii=False))
