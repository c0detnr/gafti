def main():
    MODELS.mkdir(parents=True, exist_ok=True)
    PREVIEWS.mkdir(parents=True, exist_ok=True)
    arguments = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else []
    names = [argument for argument in arguments if not argument.startswith("--")]
    unknown = set(names) - BUILDERS.keys()
    if unknown:
        raise ValueError(f"Unknown props: {sorted(unknown)}")
    if "--sheet-only" in arguments:
        sheet()
        return
    for name in names or BUILDERS:
        bpy.ops.wm.read_factory_settings(use_empty=True)
        COLORS.clear()
        COLORS.update(palette())
        objects = BUILDERS[name]()
        export(name, objects)
        if "--export-only" not in arguments:
            preview(name, objects)
    if not names and "--export-only" not in arguments:
        sheet()


if __name__ == "__main__":
    try:
        main()
    except Exception:
        # The Store launcher does not pass Blender's --python-exit-code.
        import os
        import tempfile
        import traceback

        diagnostic = Path(tempfile.gettempdir()) / "gafti_props_error.txt"
        diagnostic.write_text(traceback.format_exc(), encoding="utf-8")
        traceback.print_exc()
        sys.stderr.flush()
        os._exit(1)

    for p,power,size in [((-6,-9,13),2600,8),((7,-4,8),1150,7),((0,8,12),2000,6)]:
        bpy.ops.object.light_add(type='AREA',location=p)
        light=bpy.context.object
        light.data.energy=power
        light.data.shape='DISK'
        light.data.size=size
        light.rotation_euler=(-light.location).to_track_quat('-Z','Y').to_euler()
    target=Vector((0,0,1.5 if name=="greenhouse" else 3.15))
    bpy.ops.object.camera_add(location=target+Vector((9,-17,8.2)))
    camera=bpy.context.object
    camera.rotation_euler=(target-camera.location).to_track_quat('-Z','Y').to_euler()
    camera.data.type='ORTHO'
    camera.data.ortho_scale=16.1 if name=='greenhouse' else 14.6
    scene.camera=camera
    scene.render.filepath=str(PREVIEW/(name+'.png'))
    bpy.ops.render.render(write_still=True)


def generate(name, builder):
    bpy.ops.wm.read_factory_settings(use_empty=True)
    parts.clear()
    rng.seed(1912)
    builder()
    realize()
    path=OUT/(name+".glb")
    bpy.ops.export_scene.gltf(filepath=str(path),export_format='GLB',export_yup=True,
                              export_vertex_color='ACTIVE',export_cameras=False,export_lights=False)
    raw=path.read_bytes()
    length=struct.unpack_from('<I',raw,12)[0]
    gltf=json.loads(raw[20:20+length])
    tris=sum(gltf['accessors'][p['indices']]['count']//3 for m in gltf['meshes'] for p in m['primitives'])
    assert tris<=8000,(name,tris)
    print(name,tris,"triangles",flush=True)
    preview(name)


