@'
extends SceneTree

const BUILDINGS: Dictionary[String, float] = {
	\"shop_building\": 0.0, \"kahvehane\": -0.78, \"muhtarlik\": 0.0,
	\"hardware_store\": 1.0, \"inspection_office\": 0.0, \"drying_barn\": 0.0,
}
var stage: Node3D
var problems: int = 0

func _initialize() -> void:
	call_deferred(\"_run\")

func check(condition: bool, message: String) -> void:
	if not condition:
		printerr(message)
		problems += 1

func ray(a: Vector3, b: Vector3) -> Dictionary:
	return stage.get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(a, b))

func ground_at(x: float, z: float, expected: float, label: String) -> void:
	var hit: Dictionary = ray(Vector3(x, 70, z), Vector3(x, -10, z))
	check(not hit.is_empty() and absf(hit.position.y - expected) < 0.015,
		\"%s (%s,%s) expected %s, got %s\" % [label, x, z, expected, hit.get(\"position\")])

func _run() -> void:
	stage = Node3D.new()
	root.add_child(stage)
	for name: String in BUILDINGS.keys() + [\"bus_stop\", \"bridge\", \"minibus\", \"terrain\"]:
		var scene: PackedScene = load(\"res://%s.glb\" % name) as PackedScene
		if scene == null:
			check(false,\"Could not import \" + name)
			continue
		var asset: Node3D = scene.instantiate() as Node3D
		stage.add_child(asset)
		await physics_frame
		await physics_frame
		var bodies: Array[Node] = asset.find_children(\"*\", \"StaticBody3D\", true, false)
		var shapes: Array[Node] = asset.find_children(\"*\", \"CollisionShape3D\", true, false)
		check(not bodies.is_empty() and not shapes.is_empty(), \"Missing imported collision for \" + name)
		print(name, \" bodies=\", bodies.size(), \" shapes=\", shapes.size())
		if BUILDINGS.has(name):
			var door_x: float = BUILDINGS[name]
			check(ray(Vector3(door_x, 1.15, 5), Vector3(door_x, 1.15, 0)).is_empty(),
				name + \": +Z doorway is blocked\")
			check(ray(Vector3(door_x, 1.15, -5), Vector3(door_x, 1.15, 0)).size() > 0,
				name + \": rear wall lacks collision\")
			check(not ray(Vector3(0, 1, 0), Vector3(0, -1, 0)).is_empty(), name + \": missing interior floor\")
			check(not ray(Vector3(5, 1.1, 0), Vector3(0, 1.1, 0)).is_empty(), name + \": missing side wall\")
		elif name == \"terrain\":
			ground_at(-62, 28, 2, \"Spawn\")
			ground_at(-70, 40, 2, \"House\")
			ground_at(-55, 30, 2, \"Greenhouse\")
			ground_at(-45, 48, 2, \"Field\")
			ground_at(-78, 22, 2, \"Barn\")
			ground_at(60, -14, 0, \"Shop\")
			ground_at(46, 8, 0, \"Cafe\")
			ground_at(74, 8, 0, \"Municipality\")
			ground_at(78, -8, 0, \"Inspection office\")
			ground_at(42, -10, 0, \"Hardware store\")
			ground_at(5, -45, -1, \"Creek at bridge\")
			ground_at(5, -40, 0, \"South bridge ramp\")
			ground_at(5, -50, 0, \"North bridge ramp\")
			for pad: Vector4 in [Vector4(-70,40,14,2), Vector4(60,0,22,0),
					Vector4(72,48,6,0), Vector4(0,-110,6,28)]:
				for i in range(72):
					var angle: float = TAU * i / 72.0
					ground_at(pad.x + cos(angle)*pad.z, pad.y + sin(angle)*pad.z, pad.w, \"Pad perimeter\")
			for line: Array in [
				[Vector3(127,20,-35),Vector3(134,20,-35)],
				[Vector3(-127,20,-60),Vector3(-134,20,-60)],
				[Vector3(10,45,127),Vector3(10,45,134)],
				[Vector3(0,47,-127),Vector3(0,47,-134)]]:
				check(not ray(line[0], line[1]).is_empty(), \"Open valley boundary at \" + str(line))
		elif name == \"bridge\":
			var center: Dictionary = ray(Vector3(0,5,0), Vector3(0,-1,0))
			check(not center.is_empty() and absf(center.position.y-1.628) < .02, \"Incorrect bridge deck\")
			for z: float in [-4.98,4.98]:
				var hit: Dictionary = ray(Vector3(0,4,z), Vector3(0,-1,z))
				check(not hit.is_empty() and absf(hit.position.y-1.048) < .03, \"Missing bridge landing\")
			check(not ray(Vector3(2,1.90,0),Vector3(0,1.90,0)).is_empty(), \"Missing bridge railing\")
		asset.queue_free()
		await process_frame
	print(\"Failures: \", problems)
	quit(int(problems "'!= 0))
