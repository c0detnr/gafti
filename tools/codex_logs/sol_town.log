\"\"\"Build Pusludere's buildings, minibus, and bridge with matching GLB previews.\"\"\"

from math import atan2, cos, pi, sin, sqrt
from pathlib import Path
from random import Random

import bpy
from mathutils import Vector

ROOT = Path(__file__).resolve().parents[2]
OUTPUT = ROOT / \"assets/models/town\"
PREVIEWS = ROOT / \"tools/previews\"

PALETTE = {
    \"Stone\": (\"535959\", \"6E706A\", \"838078\", \"635C54\", \"92918A\"),
    \"Cobbles\": (\"6D7470\", \"81857B\", \"777A73\", \"969185\"),
    \"Timber\": (\"623C28\", \"764A30\", \"895338\", \"986543\", \"A3714D\"),
    \"Gold wood\": (\"C18756\", \"A67045\", \"D29A66\"),
    \"Dark\": (\"312D2A\",),
    \"Cream\": (\"F3D9A9\",),
    \"Window\": (\"305460\",),
    \"Glint\": (\"618687\",),
    \"Amber\": (\"FFB05B\",),
    \"Copper\": (\"A5563A\", \"944630\", \"B46044\", \"AD553E\"),
    \"Moss\": (\"426754\", \"395C50\", \"527763\", \"4C705B\"),
    \"Blue\": (\"3E6875\", \"477684\", \"547B86\", \"40606C\"),
    \"Zinc\": (\"626C71\", \"788185\", \"68777D\", \"899193\"),
    \"Red\": (\"8F3E32\", \"A94732\", \"A7553A\"),
    \"Ochre\": (\"BA793F\", \"C88949\", \"D89753\"),
    \"Green\": (\"35754F\", \"428B5B\", \"3D7E53\"),
    \"Lichen\": (\"758550\", \"96A35D\"),
    \"Rubber\": (\"282E30\",),
    \"Metal\": (\"ADAAA0\",),
    \"Ivory\": (\"E8E0CA\",),
}

parts = {}
materials = {}
rng = Random(23)


def linear_color(hex_code):
    channels = (int(hex_code[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return tuple(c / 12.92 if c <= .04045 else ((c + .055) / 1.055) ** 2.4 for c in channels)


def material(name, color, roughness=.82):
    mat = bpy.data.materials.new(name)
    mat.diffuse_color = (*linear_color(color), 1)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get(\"Principled BSDF\")
    bsdf.inputs[\"Base Color\"].default_value = mat.diffuse_color
    bsdf.inputs[\"Roughness\"].default_value = roughness
    return mat


def swatch(group, index=None):
    colors = PALETTE[group]
    color = rng.choice(colors) if index is None else colors[index % len(colors)]
    key = (group, color)
    if key not in materials:
        materials[key] = material(f\"{group} {color}\", color, .35 if group == \"Window\" else .82)
    return materials[key]


def reset_scene():
    bpy.ops.wm.read_factory_settings(use_empty=True)
    parts.clear()
    materials.clear()
    rng.seed(23)


def mesh(name, vertices, faces, mat=None):
    data = bpy.data.meshes.new(name)
    data.from_pydata(vertices, [], faces)
    data.update()
    obj = bpy.data.objects.new(name, data)
    bpy.context.collection.objects.link(obj)
    if mat:
        data.materials.append(mat)
    return obj


def add_part(obj, group):
    parts.setdefault(group, []).append(obj)
    return obj


def bevel(obj, amount, segments=1):
    modifier = obj.modifiers.new(\"Soft edges\", \"BEVEL\")
    modifier.width = amount
    modifier.segments = segments
    bpy.context.view_layer.objects.active = obj
    bpy.ops.object.modifier_apply(modifier=modifier.name)


def box(group, loc, size, color=None, soft=0, rotation=0):
    x, y, z = (axis / 2 for axis in size)
    obj = mesh(group, [(-x, -y, -z), (x, -y, -z), (x, y, -z), (-x, y, -z),
                       (-x, -y, z), (x, -y, z), (x, y, z), (-x, y, z)],
               [(3, 2, 1, 0), (0, 1, 5, 4), (1, 2, 6, 5), (2, 3, 7, 6),
                (3, 0, 4, 7), (4, 5, 6, 7)], swatch(color) if color else None)
    obj.location = loc
    obj.rotation_euler.y = rotation
    if soft:
        bevel(obj, soft)
    return add_part(obj, group)


def beam(group, a, b, width, depth, color, soft=0):
    a, b = Vector(a), Vector(b)
    obj = box(group, (a + b) * .5, (width, depth, (b - a).length), color, soft)
    obj.rotation_euler = (b - a).to_track_quat(\"Z\", \"Y\").to_euler()
    return obj


def tube(group, loc, radius, depth, color, axis=\"Z\", segments=12, soft=0):
    rotation = (0, pi / 2, 0) if axis == \"X\" else (pi / 2, 0, 0) if axis == \"Y\" else (0, 0, 0)
    bpy.ops.mesh.primitive_cylinder_add(vertices=segments, radius=radius, depth=depth,
                                       location=loc, rotation=rotation)
    obj = bpy.context.object
    obj.data.materials.append(swatch(color))
    if soft:
        bevel(obj, soft)
    return add_part(obj, group)


def letters(body, x, y, z, size, color=\"Cream\"):
    curve = bpy.data.curves.new(body, \"FONT\")
    curve.body = body
    curve.align_x = \"CENTER\"
    curve.align_y = \"CENTER\"
    curve.size = size
    curve.resolution_u = 2
    curve.extrude = .002
    obj = bpy.data.objects.new(body, curve)
    bpy.context.collection.objects.link(obj)
    obj.location = (x, y, z)
    obj.rotation_euler.x = pi / 2
    curve.materials.append(swatch(color))
    bpy.ops.object.select_all(action=\"DESELECT\")
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj
    bpy.ops.object.convert(target=\"MESH\")
    add_part(bpy.context.object, \"Sign\")


def combine():
    bpy.context.scene.cursor.location = (0, 0, 0)
    result = []
    for name, objects in parts.items():
        bpy.ops.object.select_all(action=\"DESELECT\")
        for obj in objects:
            obj.select_set(True)
        bpy.context.view_layer.objects.active = objects[0]
        if len(objects) > 1:
            bpy.ops.object.join()
        obj = bpy.context.object
        obj.name = name
        obj.data.name = name
        bpy.ops.object.origin_set(type=\"ORIGIN_CURSOR\")
        bpy.ops.object.transform_apply(location=True, rotation=True, scale=True)
        result.append(obj)
    return result


def export(name, objects, limit):
    OUTPUT.mkdir(parents=True, exist_ok=True)
    bpy.ops.object.select_all(action=\"DESELECT\")
    counts = {}
    for obj in objects:
        obj.select_set(True)
        obj.data.calc_loop_triangles()
        counts[obj.name] = len(obj.data.loop_triangles)
    if sum(counts.values()) > limit:
        raise ValueError(f\"{name}: {sum(counts.values())} triangles exceeds {limit}: {counts}\")
    path = OUTPUT / f\"{name}.glb\"
    bpy.ops.export_scene.gltf(filepath=str(path), export_format=\"GLB\", use_selection=True,
                              export_yup=True, export_materials=\"EXPORT\", export_animations=False)
    print(f\"TOWN_ASSET {name} {sum(counts.values())} {counts}\", flush=True)


def camera(location, target, scale):
    data = bpy.data.cameras.new(\"Preview camera\")
    cam = bpy.data.objects.new(\"Preview camera\", data)
    bpy.context.collection.objects.link(cam)
    cam.location = location
    cam.rotation_euler = (Vector(target) - cam.location).to_track_quat(\"-Z\", \"Y\").to_euler()
    data.type = \"ORTHO\"
    data.ortho_scale = scale
    data.clip_end = 1800
    bpy.context.scene.camera = cam
    return cam


def light(name, kind, location, target, energy, color, size):
    data = bpy.data.lights.new(name, kind)
    data.energy = energy
    data.color = color
    if kind == \"AREA\":
        data.shape = \"DISK\"
        data.size = size
    else:
        data.angle = size
    obj = bpy.data.objects.new(name, data)
    bpy.context.collection.objects.link(obj)
    obj.location = location
    obj.rotation_euler = (Vector(target) - obj.location).to_track_quat(\"-Z\", \"Y\").to_euler()


def render(name):
    PREVIEWS.mkdir(parents=True, exist_ok=True)
    scene = bpy.context.scene
    scene.render.engine = \"BLENDER_EEVEE\"
    scene.eevee.taa_render_samples = 24
    scene.render.resolution_x = scene.render.resolution_y = 512
    scene.render.resolution_percentage = 100
    scene.render.image_settings.file_format = \"PNG\"
    scene.render.filepath = str(PREVIEWS / f\"{name}.png\")
    scene.view_settings.view_transform = \"AgX\"
    bpy.ops.render.render(write_still=True)


def studio(name, scale, direction=(.62, -1, .64), target=(0, 0, 1.6)):
    for obj in bpy.context.scene.objects:
        if obj.name.endswith(\"-col\"):
            obj.hide_render = True
    bpy.context.scene.world = bpy.data.worlds.new(\"Studio\")
    floor = mesh(\"Preview ground\", [(-100, -100, -.026), (100, -100, -.026),
                                    (100, 100, -.026), (-100, 100, -.026)], [(0, 1, 2, 3)],
                 material(\"Dried sage backdrop\", \"708478\"))
    camera(Vector(target) + Vector(direction) * 15, target, scale)
    light(\"Sun\", \"SUN\", (-8, -10, 16), (0, 0, 0), 2.6, (1, .83, .67), .16)
    light(\"Sky\", \"AREA\", (2, -6, 10), target, 1600, (.69, .85, 1), 12)
    light(\"Bounce\", \"AREA\", (-4, 7, 8), target, 2200, (1, .70, .47), 9)
    if name == \"bridge\":
        floor.location.z = -1.0
    render(name)


def window(x, y, z, w, h, trim, *, shutter=False, awning=False):
    box(\"Windows\", (x, y + .025, z), (w, .13, h), \"Dark\", .035)
    box(\"Windows\", (x, y - .05, z), (w - .14, .042, h - .14), \"Window\")
    for side in (-1, 1):
        box(\"Windows\", (x + side * (w / 2 - .035), y - .064, z), (.081, .13, h), trim, .013)
        box(\"Windows\", (x, y - .064, z + side * (h / 2 - .035)), (w, .13, .08), trim, .014)
        if shutter:
            sx = x + side * (w / 2 + .16)
            box(\"Shutters\", (sx, y - .065, z), (.29, .095, h - .06), trim, .022)
            for offset in (-.23, 0, .23):
                box(\"Shutters\", (sx, y - .12, z + offset * h), (.26, .04, .041), \"Gold wood\", .007)
    box(\"Windows\", (x, y - .084, z), (.062, .07, h - .13), trim, .007)
    box(\"Windows\", (x, y - .086, z - .08), (w - .14, .07, .059), trim, .007)
    box(\"Windows\", (x, y - .09, z - h / 2 - .024), (w + .18, .23, .09), \"Gold wood\", .014)
    for j in (-1, 1):
        box(\"Windows\", (x + j * w * .24, y - .076, z + h * .25),
            (w * .26, .008, .036), \"Glint\", rotation=-.44)
    if awning:
        for j in range(7):
            shade = \"Cream\" if j % 2 else trim
            px = x + (j - 3) * (w + .25) / 7
            beam(\"Awning\", (px, y - .40, z + h / 2 + .06),
                 (px, y - .02, z + h / 2 + .28), (w + .25) / 7, .039, shade)
            box(\"Awning\", (px, y - .40, z + h / 2 + .015), ((w + .25) / 7, .039, .12), shade, .012)


def masonry(x1, x2, y, bottom, top):
    row_height = (top - bottom) / max(1, round((top - bottom) / .42))
    for row in range(round((top - bottom) / row_height)):
        x = x1
        while x < x2 - .028:
            step = min(x2 - x, rng.uniform(.43, .86) if x > x1 or row % 2 == 0 else .29)
            if step < .10:
                break
            box(\"Stonework\", (x + step / 2, y + rng.uniform(-.025, .008),
                              bottom + (row + .5) * row_height),
                (step - .034, .14, row_height - .035), \"Stone\", .043)
            x += step


def roof(w, d, eave, rise, color, overhang=.57):
    half = w / 2 + overhang
    front, back = -d / 2 - overhang, d / 2 + overhang
    spans = round((back - front) / .29)
    for side in (-1, 1):
        for i in range(spans):
            spacing = (back - front) / spans
            py = front + (i + .5) * spacing
            beam(\"Roof\", (side * half, py, eave), (0, py, eave + rise),
                 .080, spacing + .008, color)
            beam(\"Roof seams\", (side * half, py - spacing / 2, eave + .053),
                 (0, py - spacing / 2, eave + rise + .053), .043, .039, color)
        for py in (front, back):
            beam(\"Fascia\", (side * (half + .03), py, eave - .07), (0, py, eave + rise - .07),
                 .16, .14, \"Gold wood\", .015)
        box(\"Fascia\", (side * (half + .045), 0, eave - .10), (.15, back - front, .19),
            \"Timber\", .025)
    box(\"Roof\", (0, 0, eave + rise + .04), (.18, back - front + .1, .14), color, .048)


def gable(w, d, eave, rise):
    for side in (-1, 1):
        y = side * d / 2
        for i in range(-round(w / .48), round(w / .48) + 1):
            x = i * .24
            if abs(x) + .12 > w / 2:
                continue
            heights = [eave + rise * (1 - abs(v) / (w / 2 + .57)) - .18
                       for v in (x - .115, x + .115)]
            verts = [(x - .115, y - .043, eave - .13), (x + .115, y - .043, eave - .13),
                     (x + .115, y - .043, heights[1]), (x - .115, y - .043, heights[0]),
                     (x - .115, y + .043, eave - .13), (x + .115, y + .043, eave - .13),
                     (x + .115, y + .043, heights[1]), (x - .115, y + .043, heights[0])]
            obj = mesh(\"Gable\", verts, [(3, 2, 1, 0)[::-1], (4, 7, 6, 5)[::-1],
                                        (0, 4, 5, 1)[::-1], (3, 2, 6, 7)[::-1],
                                        (0, 3, 7, 4)[::-1], (1, 5, 6, 2)[::-1]], swatch(\"Timber\"))
            add_part(obj, \"Gable\")


# Each of the five storefronts keeps a clear opening and a prop-ready interior.
BUILDINGS = {
