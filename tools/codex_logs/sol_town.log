def building(name):
    w, d, eave, rise, door_x, door_w, metal, trim, label = BUILDINGS[name]
    front = -d / 2
    ground = .018
    door_h = 2.60 if name == \"drying_barn\" else 2.26
    thesis = 1.03 if name "'!= "drying_barn" else .68
    back_center = d / 2 - .14
    wall("Floor", (0, 0, ground - .19), (w, d, .38), "Dark")
    for i in range(round(w / .28)):
        step = (w - .56) / round(w / .28)
        x = -(w - .56) / 2 + (i + .5) * step
        box("Floorboards", (x, 0, .028), (step - .004, d - .27, .02), "Gold wood")
    for side in (-1, 1):
        x = side * (w / 2 - .14)
        wall("Walls", (x, 0, eave / 2), (.28, d - .56, eave), "Timber")
        # Boards on the long sides define the rain screen above the stone plinth.
        for i in range(round((d - .46) / .29)):
            step = (d - .46) / round((d - .46) / .29)
            y = -(d - .46) / 2 + (i + .5) * step
            box("Cladding", (side * w / 2, y, (eave + thesis) / 2),
                (.09, step - .016, eave - thesis), "Timber")
        for row in range(2):
            columns = round((d - .48) / .60)
            step = (d - .48) / columns
            for i in range(columns):
                y = -(d - .48) / 2 + (i + .5) * step + (.09 if row and i < columns - 1 else 0)
                box("Stonework", (side * w / 2, y, (row + .5) * thesis / 2),
                    (.13, step - .039, thesis / 2 - .034), "Stone", .037)
        box("Frame", (side * (w / 2 + .055), 0, thesis + .035), (.145, d + .15, .14),
            "Gold wood", .022)
    wall("Walls", (0, back_center, eave / 2), (w, .28, eave), "Timber")
    for y in (front - .025, -front + .025):
        for x in (-w / 2 + .035, w / 2 - .035):
            box("Frame", (x, y, eave / 2), (.25, .23, eave), "Gold wood", .025)
    left, right = door_x - door_w / 2, door_x + door_w / 2
    for x1, x2 in [(-w / 2, left), (right, w / 2)]:
        wall("Walls", ((x1 + x2) / 2, front + .14, eave / 2),
             (x2 - x1, .28, eave), "Timber")
        masonry(x1 + .08, x2 - .08, front - .012, 0, thesis)
        planks = round((x2 - x1) / .23)
        for i in range(planks):
            step = (x2 - x1) / planks
            box("Cladding", (x1 + (i + .5) * step, front - .012, (thesis + eave) / 2),
                (step - .011, .065, eave - thesis), "Timber")
        box("Frame", ((x1 + x2) / 2, front - .075, thesis + .025),
            (x2 - x1, .16, .15), "Gold wood", .019)
    wall("Walls", (door_x, front + .14, (door_h + eave) / 2),
         (door_w, .28, eave - door_h), "Timber")
    for side in (-1, 1):
        box("Doorframe", (door_x + side * (door_w / 2 + .055), front - .07, door_h / 2),
            (.17, .25, door_h), trim, .025)
    box("Doorframe", (door_x, front - .084, door_h + .035), (door_w + .25, .26, .17), trim, .028)
    box("Threshold", (door_x, front + .045, .014), (door_w, .67, .055), "Cobbles", .013)
    box("Threshold-col", (door_x, front + .045, .014), (door_w, .67, .055))

    if name == "drying_barn":
        for x in (-2.1, 2.1):
            for offset in (-.18, 0, .18):
                box("Vents", (x + offset, front - .056, 2.68), (.11, .03, .61), "Dark", .012)
            beam("Frame", (x - .72, front - .093, 1.08), (x + .61, front - .093, 2.35),
                 .14, .13, "Gold wood", .012)
        for y in (front + .16, -front - .11):
            for x in (-3.2, 3.2):
                box("Footings", (x, y, .15), (.42, .58, .30), "Stone", .043)
    else:
        openings = [(-w / 2, left), (right, w / 2)]
        for x1, x2 in openings:
            width = min((x2 - x1) - .50, 2.16 if name == "shop_building" else 1.63)
            window((x1 + x2) / 2, front - .09, 1.67, width, .99, trim,
                   shutter=name in ("kahvehane", "muhtarlik"), awning=name == "shop_building")
        sign_width = {
            "shop_building": 2.81, "kahvehane": 5.78, "muhtarlik": 2.79,
            "hardware_store": 2.55, "inspection_office": 4.19,
        }[name]
        sign_x = 0 if name in ("kahvehane", "inspection_office") else door_x
        sign_z = 2.78 if name != "kahvehane" else 2.87
        box("Sign", (sign_x, front - .145, sign_z), (sign_width, .17, .56), "Gold wood", .04)
        box("Sign", (sign_x, front - .243, sign_z), (sign_width - .14, .075, .43), trim, .022)
        letters(label, sign_x, front - .285, sign_z,
                .42 if name == "shop_building" else .30)
        for side in (-1, 1):
            tube("Sign", (sign_x + side * (sign_width / 2 - .135), front - .294, sign_z),
                 .025, .021, "Amber", axis="Y", segments=8)
    specialize_building(name, w, d, eave, rise, front, trim)
    gable(w, d, eave, rise)
    roof(w, d, eave, rise, metal)
    box("Ceiling-col", (0, 0, eave - .135), (w, d, .17))


