def loft(name, rings, colors, split_height=None):
    count = len(rings[0])
    verts = [point for ring in rings for point in ring]
    faces = [tuple(range(count - 1,-1,-1))]
    for j in range(len(rings)-1):
        for i in range(count):
            a, b = j * count + i, j * count + (i+1) % count
            faces.append((a,b,b+count,a+count))
    faces.append(tuple(range(len(verts)-count,len(verts))))
    obj = mesh(name, verts, faces)
    for color in colors:
        obj.data.materials.append(swatch(color))
    if split_height is not None:
        for face in obj.data.polygons:
            face.material_index = int(face.center.z > split_height)
    return part(obj,name)


