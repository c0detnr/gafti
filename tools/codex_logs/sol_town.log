def skin_between(group, sections, colors):
    count = len(sections[0])
    vertices = [vertex for section in sections for vertex in section]
    faces = [tuple(reversed(range(count)))]
    for j in range(len(sections) - 1):
        for i in range(count):
            faces.append((j * count + i, j * count + (i + 1) % count,
                          (j + 1) * count + (i + 1) % count, (j + 1) * count + i))
    faces.append(tuple(range(len(vertices) - count, len(vertices))))
    obj = mesh(group, vertices, faces)
    for color in colors:
        obj.data.materials.append(swatch(color, 0))
    if len(colors) == 2:
        for face in obj.data.polygons:
            face.material_index = int(face.center.z > 1.37)
    add_part(obj, group)
    return obj


