import concurrent.futures, html, os, re, shutil, urllib.request
from pathlib import Path
root=Path(os.environ['GAFTI_AUDIO_STAGE'])
oga='https://opengameart.org/'
m={
'menu':('forget-me-not','forget_me_not_in_f_major_looped.ogg'),
'day_1':('serenade-guitar',''),
'day_2':('chill-lofi-inspired-loop-edit',''),
'evening':('sunset-plains','sunset_plains.wav'),
'night':('yoiyami-core-theme-%E2%80%93-deep-blue-ambient-piano','yoiyami_core_theme.wav'),
'gafti':('first-light-particles-%E2%80%93-cc0-atmospheric-pianoambient-track','first_light_particles.wav'),
}
def req(url):
 return urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'Mozilla/5.0','Referer':'https://'+url.split('/')[2]+'/'}),timeout=20)
def write(url,to):
 with req(url) as response, to.open('wb') as out: shutil.copyfileobj(response,out,1024*128)
def run(n):
 try:
  if n=='cafe_murmur_loop':
   url='https://freesound.org/people/Ultra-Edward/sounds/823831/'
   t=req(url).read().decode()
   assert 'creativecommons.org/publicdomain/zero/1.0' in t
   dl=re.search(r'https://cdn\\.freesound\\.org/previews/["'^"'"\\s<>]+-hq\\.mp3',t)[0]
   write(dl,root/(n+'.mp3'))
   print(n,url,dl,flush=True)
   return
  slug,file=m[n]
  url=oga+'content/'+slug
  t=req(url).read().decode()
  assert 'creativecommons.org/publicdomain/zero/1.0' in t
  links=list(dict.fromkeys(html.unescape(l) for l in re.findall(r'href=\"(https://opengameart.org/sites/default/files/["'^"]+'"\\.(?:ogg|mp3|wav|zip|flac))\"',t) if '/styles/' not in l and '/audio_preview/' not in l))
  print(n,url,links,flush=True)
  dl=next((l for l in links if l.endswith('/'+file)),None) if file else next((l for l in links if l.endswith(('.ogg','.mp3','.wav'))),None)
  if not dl: return
  write(dl,root/(n+'.'+dl.rsplit('.',1)[1]))
  print('OK',n,flush=True)
 except Exception as error:
  print('ERROR',n,repr(error),flush=True)
with concurrent.futures.ThreadPoolExecutor() as pool: list(pool.map(run,[*m,'cafe_murmur_loop']))
