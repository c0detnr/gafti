from pathlib import Path
from zipfile import ZipFile
from concurrent.futures import ThreadPoolExecutor
import os, re, subprocess, json, shutil

stage = Path(os.environ['GAFTI_AUDIO_STAGE'])
asset_root = Path('assets/audio')
kenney = 'https://kenney.nl/assets/'
freesound = 'https://freesound.org/people/'
oga = 'https://opengameart.org/content/'
registry = {}

def run(*args):
    return subprocess.run(['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-y', *map(str, args)], check=True)

def source(pack, name):
    path = stage / name
    with ZipFile(stage / (pack + '.zip')) as archive:
        path.write_bytes(archive.read('Audio/' + name))
    return path

def install(group, name, path, info, url):
    out = asset_root / group / (name + '.ogg')
    shutil.copyfile(path, out)
    registry[f'{group}/{name}.ogg'] = [info, url]

def ken(name, pack, original, note=''):
    install('sfx', name, source(pack, original), f'Kenney · "'`{original}`'"' + (f' ({note})' if note else ''), kenney + pack)

for name, original in {
    'ui_click':'click_001', 'ui_open':'open_001', 'ui_close':'close_001',
    'notify_good':'confirmation_002', 'notify_bad':'error_004',
}.items():
    ken(name, 'interface-sounds', original + '.ogg')

for surface in ('grass', 'wood'):
    for variant in range(4):
        ken(f'footstep_{surface}_{variant + 1}', 'impact-sounds', f'footstep_{surface}_{variant:03}.ogg')

for name, original, note in [
    ('coin', 'handleCoins', ''),
    ('door_open', 'doorOpen_1', ''),
    ('door_close', 'doorClose_1', ''),
    ('paper_rustle', 'bookFlip2', 'sayfa hışırtısı'),
    ('lighter_flick', 'metalClick', 'metal çakma tıkı'),
    ('harvest_snip', 'knifeSlice2', 'kısa kesme sesi'),
    ('plant_place', 'metalPot2', 'kap yerleştirme sesi'),
]:
    ken(name, 'rpg-audio', original + '.ogg', note)

rpg, impacts = 'rpg-audio', 'impact-sounds'
grind = stage / 'edit-grinder.ogg'
run('-i', source(rpg, 'drawKnife1.ogg'), '-i', source(rpg, 'drawKnife2.ogg'),
    '-filter_complex', '[0:a]atempo=1.2,volume=0.65[a];[1:a]atempo=1.25,volume=0.55,adelay=155:all=1[b];[a][b]amix=inputs=2:normalize=0,alimiter=limit=0.75:level=0:latency=1',
    '-c:a', 'libvorbis', '-q:a', 5, grind)
install('sfx', 'grinder', grind, 'Kenney · "'`drawKnife1.ogg` + `drawKnife2.ogg` (metal sürtünme kurgusu)'"', kenney + rpg)

register = stage / 'edit-cash.ogg'
run('-i', source(rpg, 'metalLatch.ogg'), '-i', source(impacts, 'impactBell_medium_001.ogg'),
    '-filter_complex', '[0:a]volume=0.65[a];[1:a]volume=0.4,adelay=95:all=1[b];[a][b]amix=inputs=2:normalize=0,alimiter=limit=0.75:level=0:latency=1',
    '-c:a', 'libvorbis', '-q:a', 5, register)
install('sfx', 'cash_register', register, 'Kenney · "'`metalLatch.ogg` + `impactBell_medium_001.ogg` (mandal ve zil kurgusu)'"', kenney + rpg)
registry['sfx/cash_register.ogg'].append(kenney + impacts)

ambience = {
    'rain_loop': ('Nox_Sound/sounds/535870/', 'Nox_Sound · Ambiance_Rain_Inside_Car_Close_Roof_Loop_Stereo.wav', 'rain_loop.mp3', 0.4, 22),
    'birds_loop': ('Magnesus/sounds/723913/', 'Magnesus · Forest birds – ambient seamless loop', 'birds_loop.mp3', 0.3, 26.4),
    'creek_loop': ('kentspublicdomain/sounds/325182/', 'kentspublicdomain · River, stream, creek, sound of waves, moving water', 'creek_loop.mp3', 0.5, 29.5),
    'wind_loop': ('Nox_Sound/sounds/530907/', 'Nox_Sound · Ambiance_Wind_Forest_Trees_Loop_02.wav', 'wind_loop.mp3', 0.4, 23),
    'night_crickets_loop': ('Vrymaa/sounds/734642/', 'Vrymaa · Night crickets', 'night_crickets_loop.mp3', 0.5, 32.5),
    'cafe_murmur_loop': ('Ultra-Edward/sounds/823831/', 'Ultra-Edward · Cafe/Coffee shop', 'cafe_ultra.mp3', 8.0, 41.5),
}

def process_ambience(entry):
    name, (slug, credit, file, start, duration) = entry
    if not (stage / file).is_file():
        raise FileNotFoundError(stage / file)
    intermediate = stage / (name + '.wav')
    output = stage / (name + '.ogg')
    fade = min(duration / 16, 1.45)
    graph = (f'[0:a]highpass=f=55,atrim=start={start}:duration={duration},asetpts=PTS-STARTPTS,asplit=3[a][b][c];'
             f'[a]atrim=start={fade}:end={duration-fade},asetpts=PTS-STARTPTS[body];'
             f'[b]atrim=start={duration-fade},asetpts=PTS-STARTPTS[tail];'
             f'[c]atrim=end={fade},asetpts=PTS-STARTPTS[head];'
             f'[tail][head]acrossfade=d={fade}:c1=qsin:c2=qsin[join];[body][join]concat=n=2:v=0:a=1[out]')
    run('-i', stage / file, '-filter_complex', graph, '-map', '[out]', '-c:a', 'pcm_f32le', intermediate)
    levels = subprocess.run(['ffmpeg', '-nostdin', '-hide_banner', '-i', str(intermediate),
                              '-af', 'volumedetect', '-f', 'null', 'NUL'], capture_output=True, text=True, check=True).stderr
    mean, peak = (float(re.search(label + r'_volume: ([-0-9.]+)', levels)[1]) for label in ('mean', 'max'))
    gain = min(-27 - mean, -7 - peak)
    run('-i', intermediate, '-af', f'volume={gain}dB', '-ar', 44100, '-c:a', 'libvorbis', '-q:a', 4, output)
    install('ambience', name, output, credit + ' (HQ MP3 kaynak, döngü kurgusu)', freesound + slug)

with ThreadPoolExecutor() as pool:
    list(pool.map(process_ambience, ambience.items()))

(stage / 'registry.json').write_text(json.dumps(registry, ensure_ascii=False, indent=2), encoding='utf-8')
