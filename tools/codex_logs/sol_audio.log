from pathlib import Path
import os, subprocess, shutil, json, hashlib, concurrent.futures

stage = Path(os.environ['GAFTI_AUDIO_STAGE'])
asset_root = Path('assets/audio')
site = 'https://opengameart.org/content/'
registry = json.loads((stage / 'registry.json').read_text(encoding='utf-8'))
music = {
    'menu': ('menu.ogg', 'Kistol · Forget Me Not (looped)', 'forget-me-not'),
    'day_1': ('day_1.wav', 'Pro Sensory · Serenade Guitar', 'serenade-guitar'),
    'day_2': ('day_2.ogg', 'omfgdude / qubodup · Chill lofi inspired [loop edit]', 'chill-lofi-inspired-loop-edit'),
    'evening': ('evening_alt.ogg', 'KiluaBoy · Sunset Walk', 'sunset-walk-ambient-quiet-sweet-loop'),
    'night': ('night_preview.ogg', 'Yoiyami · Yoiyami Core Theme – Deep Blue Ambient Piano (OpenGameArt OGG önizlemesi)', 'yoiyami-core-theme-%E2%80%93-deep-blue-ambient-piano'),
    'gafti': ('gafti.mp3', 'Yoiyami · First Light Particles (OpenGameArt MP3 önizlemesi)', 'first-light-particles-%E2%80%93-cc0-atmospheric-pianoambient-track'),
}
for name, (original, title, slug) in music.items():
    rel = f'music/{name}.ogg'
    path = asset_root / rel
    if original.endswith('.ogg'):
        shutil.copyfile(stage / original, path)
    else:
        subprocess.run(['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-y', '-xerror',
                        '-i', str(stage / original), '-map', '0:a:0', '-map_metadata', '-1',
                        '-ar', '44100', '-c:a', 'libvorbis', '-q:a', '5', str(path)], check=True)
    registry[rel] = [title, site + slug]

measures = {}
def verify(rel):
    path = asset_root / rel
    raw = subprocess.check_output(['ffprobe', '-v', 'error', '-show_entries',
                                   'stream=codec_name,channels,sample_rate:format=duration',
                                   '-of', 'json', str(path)], text=True)
    info = json.loads(raw)
    assert len(info['streams']) == 1 and info['streams'][0]['codec_name'] == 'vorbis', rel
    assert float(info['format']['duration']) > 0.1, rel
    subprocess.run(['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-xerror',
                    '-i', str(path), '-f', 'null', 'NUL'], check=True)
    return rel, float(info['format']['duration']), hashlib.sha256(path.read_bytes()).hexdigest()

with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
    results = list(pool.map(verify, sorted(registry)))
assert len({sha for _, _, sha in results}) == 34
assert set(registry) == {p.relative_to(asset_root).as_posix() for p in asset_root.rglob('*.ogg')}
measures = {name: duration for name, duration, _ in results}
(stage / 'deliverables.json').write_text(json.dumps(registry, ensure_ascii=False, indent=2), encoding='utf-8')
(stage / 'durations.json').write_text(json.dumps(measures, indent=2), encoding='utf-8')
print(f'{len(measures)} dosya çözüldü')
